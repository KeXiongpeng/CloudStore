# Copy to .env.prod-local.local and fill real rehearsal values.
# Never commit .env.prod-local.local.

POSTGRES_USER=csp_user
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=cloud_storage

JWT_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=cloudstore-prod-local
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:39000

APP_URL=http://localhost:3101
FRONTEND_URL=http://localhost:3101
CORS_ORIGIN=http://localhost:3101

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-demo-password

SILICONFLOW_API_KEY=your-rehearsal-siliconflow-key
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

DEEPSEEK_API_KEY=your-rehearsal-deepseek-key
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3101/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3101/api/auth/google/callback

WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3101/api/auth/wechat/callback
