{
    "name":  "cloud-storage-platform",
    "version":  "0.1.0",
    "private":  true,
    "description":  "云存储文件分享平台",
    "scripts":  {
                    "dev":  "docker compose -f docker-compose.yml up --build",
                    "dev:build":  "docker compose -f docker-compose.yml up -d --build",
                    "start":  "docker compose -f docker-compose.yml up -d",
                    "stop":  "docker compose down",
                    "logs":  "docker compose logs -f",
                    "dev:deps":  "docker compose -f docker-compose.dev.yml up -d"
                }
}
